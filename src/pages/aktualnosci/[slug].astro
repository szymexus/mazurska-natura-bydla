---
import { Image } from 'astro:assets';
import NewsLayout from '../../layouts/NewsLayout.astro';
import { news, newsUrl } from '../../data/news';
export function getStaticPaths() {
  return news.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<NewsLayout title={post.title} description={post.excerpt}>
  <article class="wrap section news-article">
    <a class="news-back" href={newsUrl()}>← Wszystkie aktualności</a>
    <header class="news-article-heading">
      <p class="eyebrow">{post.category}</p>
      <time datetime={post.date}>{post.label}</time>
      <h1>{post.title}</h1>
      <p class="lead">{post.excerpt}</p>
    </header>
    <figure class="news-main-photo">
      <Image src={post.photos[0].src} widths={[640, 960, 1440, 1920]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1392px) calc(100vw - 112px), 1280px" width={1920} format="webp" loading="eager" alt={post.photos[0].alt} />
      <figcaption>{post.photos[0].caption}</figcaption>
    </figure>
    <div class="news-prose">{post.paragraphs.map(text => <p>{text}</p>)}</div>
    {post.photos.slice(1).map(photo => <figure class="news-extra-photo">
      <Image src={photo.src} widths={[640, 960, 1440]} sizes="(max-width: 760px) calc(100vw - 40px), 900px" width={1440} format="webp" loading="lazy" alt={photo.alt} />
      <figcaption>{photo.caption}</figcaption>
    </figure>)}
    <a class="text-link" href={newsUrl()}>Wróć do aktualności <span aria-hidden="true">↗</span></a>
  </article>
</NewsLayout>

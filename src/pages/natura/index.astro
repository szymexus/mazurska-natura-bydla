---
import { Image } from 'astro:assets';
import pasture from '../../assets/pastwisko.jpg';
import people from '../../assets/wspolpraca.jpg';
import cattle from '../../assets/bydlo-nad-woda.jpg';
import '../../styles/global.css';
const asset = (name: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${name}`;
const areas = [
  { number: '01', name: 'Zdrowie i dobrostan', text: 'Chcemy lepiej rozumieć zdrowie i zachowania zwierząt w ich codziennym otoczeniu. Szukamy sposobów obserwacji stada, które pomogą wspierać dobrostan i ograniczać stres.', symbol: '◌' },
  { number: '02', name: 'Pastwiska i żywienie', text: 'Pastwisko to przestrzeń życia i źródło pokarmu. Przygotowujemy rekomendacje, które połączą potrzeby żywieniowe stada z wykorzystaniem pastwisk w ekstensywnym chowie.', symbol: '≋' },
  { number: '03', name: 'Cyfrowe zarządzanie', text: 'Czujniki IoT i analiza danych mają pomagać hodowcy czuwać nad stadem także wtedy, gdy zwierzęta pozostają na pastwisku. Technologię dobieramy do potrzeb zwierząt i warunków gospodarstwa.', symbol: '⌁' },
];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Alternatywna propozycja narracji: naturalny rytm życia stada, swoboda na pastwisku i technologia wspierająca opiekę hodowcy." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#233e30" />
    <title>Mazurska Natura Bydła — naturalny rytm stada | Wariant do porównania</title>
    <link rel="icon" href={asset('logo.png')} type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <aside class="variant-note" aria-label="Informacja o wariancie"><div class="wrap">Propozycja alternatywnej narracji · do porównania <a href={import.meta.env.BASE_URL}>Zobacz obecną wersję ↗</a></div></aside>
    <header class="header wrap">
      <a class="brand" href="#start" aria-label="Mazurska Natura Bydła — początek strony">
        <img src={asset('logo.png')} width="58" height="58" alt="" />
        <span>Mazurska<br />Natura Bydła</span>
      </a>
      <nav aria-label="Nawigacja główna">
        <a href="#projekt">O projekcie</a>
        <a href="#obszary">Nasze kierunki</a>
        <a href="#o-nas">O nas <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="tresc">
      <section class="hero" id="start" aria-labelledby="hero-title">
        <Image class="hero-photo" src={pasture} widths={[640, 960, 1440, 1920, 2400]} sizes="100vw" width={2400} format="webp" quality={85} loading="eager" fetchpriority="high" alt="Stado bydła na naturalnym pastwisku przy wodzie, w otoczeniu drzew" />
        <div class="hero-shade"></div>
        <div class="hero-content wrap">
          <p class="eyebrow light"><span class="dot"></span> Grupa operacyjna EPI</p>
          <h1 id="hero-title">Ich naturalny rytm.<br /><em>Nasza uważność.</em></h1>
          <p class="hero-intro">Przestrzeń do życia w stadzie. Technologia, która pomaga czuwać.<br class="desktop" /> Taki kierunek nadajemy naszemu projektowi.</p>
          <a class="button cream" href="#projekt">Poznaj nasz projekt <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-bottom wrap"><span>Mazurska Natura Bydła</span><a href="#projekt">Bliżej natury <span aria-hidden="true">↓</span></a></div>
      </section>
      <section class="intro wrap section" id="projekt" aria-labelledby="intro-title">
        <div><p class="eyebrow">01 / Idea projektu</p><h2 id="intro-title">Przestrzeń do życia.<br /><em>W zgodzie z naturą.</em></h2></div>
        <div class="intro-copy"><span class="small-sprout" aria-hidden="true">❧</span><p class="lead">Niech natura wyznacza rytm.<br />My szukamy sposobów, by lepiej go rozumieć.</p><p>Pastwisko, ruch i życie w stadzie — od tego zaczynamy myślenie o hodowli. Chcemy zachować przestrzeń dla naturalnych zachowań zwierząt, a jednocześnie lepiej rozumieć ich zdrowie i potrzeby.</p><p>W Grupie Operacyjnej EPI „Mazurska Natura Bydła” łączymy doświadczenie hodowców, wiedzę ekspertów i narzędzia cyfrowe. Przygotowujemy rozwiązania, które mają wspierać opiekę nad stadem w ekstensywnym chowie bydła opasowego — blisko warunków, w których żyją zwierzęta.</p><a class="text-link" href="#obszary">Zobacz, nad czym pracujemy <span aria-hidden="true">↗</span></a></div>
      </section>
      <section class="directions" id="obszary" aria-labelledby="areas-title">
        <div class="wrap section"><div class="section-heading"><div><p class="eyebrow">02 / Nasze kierunki</p><h2 id="areas-title">Naturalne życie stada.<br /><em>Uważna opieka.</em></h2></div><p>Trzy kierunki projektu.<br />Wspólny punkt wyjścia: zwierzęta.</p></div>
          <div class="areas">{areas.map(area => <article class="area"><div class="area-top"><span>{area.number}</span><span class="area-symbol" aria-hidden="true">{area.symbol}</span></div><h3>{area.name}</h3><p>{area.text}</p></article>)}</div>
          <p class="areas-note">Rozwijamy założenia projektu w ramach wsparcia przygotowawczego.</p>
        </div>
      </section>
      <section class="about wrap section" id="o-nas" aria-labelledby="about-title">
        <figure><Image src={people} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" width={1200} format="webp" alt="Uczestnicy spotkania grupy przy wspólnym stole" loading="lazy" /><figcaption>Różne doświadczenia. Wspólny kierunek.</figcaption></figure>
        <div class="about-copy"><p class="eyebrow">03 / Ludzie i współpraca</p><h2 id="about-title">Łączy nas troska<br /><em>o życie stada.</em></h2><p class="lead">Zaczynamy od obserwacji.<br />Rozwijamy przez współpracę.</p><p>Hodowcy znają swoje zwierzęta i pastwiska. Eksperci wnoszą wiedzę, a narzędzia cyfrowe otwierają nowe możliwości obserwacji. Wspólnie szukamy sposobów, by wspierać naturalny rytm życia stada i codzienną pracę gospodarstwa.</p><p>To kierunek naszych prac przygotowawczych: świadoma opieka nad zwierzętami, z miejscem na ich naturalne zachowania.</p></div>
      </section>
      <section class="closing closing-landscape" aria-label="Blisko stada, blisko natury">
        <div class="closing-layout wrap">

        <div class="closing-body"><p class="eyebrow light">Mazurska Natura Bydła</p><p class="closing-title">Blisko stada.<br /><em>Blisko natury.</em></p><a href="#start" aria-label="Wróć na początek strony">↑</a></div>
        <div class="closing-landscape-photo">
          <Image src={cattle} widths={[480, 800, 1200, 1600]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1392px) 50vw, 640px" width={2400} format="webp" quality={85} loading="lazy" alt="Długowłose bydło z rozłożystymi rogami nad wodą; w tle stado na zielonym pastwisku i drzewa" />
        </div>
        </div>
      </section>
    </main>
    <footer>
      <div class="funding wrap"><img src={asset('finansowanie.png')} width="1385" height="221" loading="lazy" alt="Plan Strategiczny dla Wspólnej Polityki Rolnej na lata 2023–2027. Agencja Restrukturyzacji i Modernizacji Rolnictwa. Dofinansowane przez Unię Europejską." /><p>Przygotowano w ramach umowy nr 00325.DOPI.65730.228.2026 o przyznaniu pomocy w ramach interwencji I.13.5 Współpraca Grup Operacyjnych EPI – Zakres Wsparcie Przygotowawcze.</p></div>
      <div class="footer-bottom wrap"><span>Grupa Operacyjna EPI „Mazurska Natura Bydła”</span><span>Natura · Wiedza · Współpraca</span></div>
    </footer>
  </body>
</html>

<style>
  .variant-note { background: #233e30; color: #f5f2e9; font-size: 14px; padding-block: 12px; }
  .variant-note .wrap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; line-height: 1.6; }
  .variant-note a { text-decoration: underline; text-underline-offset: 4px; }
</style>

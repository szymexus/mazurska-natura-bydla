---
import { Image } from 'astro:assets';
import { news, newsUrl } from '../data/news';
interface Props { limit?: number; eager?: boolean }
const { limit = news.length, eager = false } = Astro.props;
---
<div class="news-grid">
  {news.slice(0, limit).map(post => <article class="news-card">
    <a class="news-photo-link" href={newsUrl(post.slug)} aria-label={post.title} tabindex="-1" aria-hidden="true">
      <Image src={post.photos[0].src} widths={[400, 640, 960]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) 45vw, 400px" width={960} format="webp" loading={eager ? "eager" : "lazy"} decoding="sync" alt="" />
    </a>
    <div class="news-meta"><time datetime={post.date}>{post.label}</time><span>{post.category}</span></div>
    <h3><a href={newsUrl(post.slug)}>{post.title}</a></h3>
    <p>{post.excerpt}</p>
    <a class="text-link" href={newsUrl(post.slug)} aria-label={`Zobacz relację: ${post.title}`}>Zobacz relację <span aria-hidden="true">↗</span></a>
  </article>)}
</div>
